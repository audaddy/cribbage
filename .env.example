# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses SQLite and needs no server.
DATABASE_URL="file:./dev.db"
# For production, switch `provider` in prisma/schema.prisma to "postgresql"
# and use a connection string instead, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/cribbage?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs session cookies and magic-link tokens. MUST be changed for production.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-before-deploying"

# Public origin, used to build magic links and invite links.
APP_URL="http://localhost:3000"

# How long a magic link stays valid, and how long a session lasts.
MAGIC_LINK_TTL_MINUTES="15"
SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# With no SMTP/provider configured, magic links and notifications are written
# to the server log instead of being sent. In development the login page also
# returns the link directly so you can click straight through.
DEV_ECHO_MAGIC_LINK="true"

# Generic SMTP-over-HTTP provider hook. Any service that accepts a JSON POST
# works (Resend, Postmark, Loops, a self-hosted relay, …).
# EMAIL_WEBHOOK_URL="https://api.resend.com/emails"
# EMAIL_WEBHOOK_TOKEN="re_xxxxxxxxxxxx"
# EMAIL_FROM="Cribbage <cribbage@example.com>"

# ---------------------------------------------------------------------------
# Turn notifications (optional)
# ---------------------------------------------------------------------------
# Fired once per turn hand-off. Receives a JSON body describing the game, the
# player to notify and a deep link. Point it at a Discord/Slack webhook, a push
# service, or your own relay.
# NOTIFY_WEBHOOK_URL="https://hooks.example.com/cribbage"
# NOTIFY_WEBHOOK_TOKEN=""
