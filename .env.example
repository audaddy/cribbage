# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Production runs on Postgres. On Neon, use the POOLED connection string —
# serverless functions open a lot of short-lived connections and a direct
# connection will exhaust the limit.
# Two strings, and the difference matters.
#
# DATABASE_URL is the POOLED endpoint — on Neon its hostname contains
# `-pooler`. Serverless functions open a lot of short-lived connections and a
# direct one runs out of them.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL is the same database WITHOUT the pooler. Migrations take advisory
# locks and run DDL in transactions, neither of which survives a
# transaction-mode pooler, so Prisma runs them over this instead.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Local development: either point the URL at a local Postgres, e.g.
#   createdb cribbage_dev
#   DATABASE_URL="postgresql://localhost:5432/cribbage_dev"
#   DIRECT_URL="postgresql://localhost:5432/cribbage_dev"   # no pooler locally
#   npx prisma migrate deploy
# or drop to SQLite with no server at all:
#   npm run db:use sqlite && npm run db:push
#   DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth (required in production)
# ---------------------------------------------------------------------------
# Signs session cookies and hashes magic-link tokens. Rotating it signs
# everyone out — including guests, whose cookie is their only credential.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-before-deploying"

# Public origin. Invite and sign-in links are built from it, so if this is
# wrong the links you text to people will point at the wrong place.
#
# On Vercel you can leave this unset: the project's production domain is read
# from VERCEL_PROJECT_PRODUCTION_URL. Set it explicitly for a custom domain.
APP_URL="http://localhost:3000"

# How long a magic link stays valid, and how long a session lasts.
MAGIC_LINK_TTL_MINUTES="15"
SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Email (optional)
# ---------------------------------------------------------------------------
# Not needed to play: invite links seat a guest with no email at all. Email is
# only used for signing back in on a new device, and for turn notifications.
#
# With nothing configured, magic links are written to the server log. In
# development the sign-in page also shows the link directly.
DEV_ECHO_MAGIC_LINK="true"

# Any provider that accepts a JSON POST works (Resend, Postmark, Loops, a
# self-hosted relay).
# EMAIL_WEBHOOK_URL="https://api.resend.com/emails"
# EMAIL_WEBHOOK_TOKEN="re_xxxxxxxxxxxx"
# EMAIL_FROM="Cribbage <cribbage@example.com>"

# ---------------------------------------------------------------------------
# Turn notifications (optional)
# ---------------------------------------------------------------------------
# Fired once per turn hand-off, with a JSON body describing the game, the
# player to notify and a deep link. Point it at a push service, a Discord or
# Slack webhook, or your own relay.
# NOTIFY_WEBHOOK_URL="https://hooks.example.com/cribbage"
# NOTIFY_WEBHOOK_TOKEN=""
